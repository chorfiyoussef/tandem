{
	email {$ACME_EMAIL}
}

# Self-hosted variant: the web app runs here too (docker compose --profile web).
{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

{$SUPABASE_DOMAIN} {
	encode zstd gzip
	reverse_proxy api-gw:8000
	header -Server
}
