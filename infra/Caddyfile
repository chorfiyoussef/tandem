{
	email {$ACME_EMAIL}
}

# The Tandem API. The web app itself is served by Cloudflare (see README).
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# Supabase: /auth/v1, /rest/v1, /realtime/v1, /storage/v1 for the browser,
# and Studio at / (protected by basic auth inside Envoy).
{$SUPABASE_DOMAIN} {
	encode zstd gzip
	reverse_proxy api-gw:8000
	header -Server
}
