############################################################################
# Tandem production environment
#
# Run `node scripts/generate-env.mjs` to create a filled-in .env from this
# file. Only the values under "You must set" need a human.
############################################################################

# ---- You must set -------------------------------------------------------
# Where people open Tandem. Served by Cloudflare Workers (or by this server
# with the `web` compose profile). Used for auth redirects, invite links, CORS.
APP_DOMAIN=tandem.example.com
# The Tandem API and Supabase, both served from this server by Caddy.
API_DOMAIN=api.tandem.example.com
SUPABASE_DOMAIN=supabase.tandem.example.com
ACME_EMAIL=you@example.com

# SMTP is optional. Without it, invite links are shown in the UI to copy,
# and password resets are unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=Tandem <tandem@example.com>
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Tandem

# Daily due-date reminders
REMINDER_TZ=Europe/Berlin
REMINDER_HOUR=8

# ---- Generated secrets (generate-env.mjs fills these) -------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
REALTIME_DB_ENC_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
CRON_SECRET=

# ---- Derived from the domains (generate-env.mjs fills these) -----------
SUPABASE_PUBLIC_URL=https://supabase.tandem.example.com
API_EXTERNAL_URL=https://supabase.tandem.example.com/auth/v1
SITE_URL=https://tandem.example.com
ADDITIONAL_REDIRECT_URLS=https://tandem.example.com/auth/callback

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

STUDIO_DEFAULT_ORGANIZATION=Tandem
STUDIO_DEFAULT_PROJECT=Tandem

JWT_EXPIRY=3600
# Public sign-up stays off: people join through invites (created by the API
# with the service role) or the first-run /setup screen.
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
