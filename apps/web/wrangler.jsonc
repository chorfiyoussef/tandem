{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tandem-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "tandem-web" }],
  // Add your own domain here, or attach it in the dashboard (Settings → Domains & Routes):
  // "routes": [{ "pattern": "tandem.example.com", "custom_domain": true }],
  "observability": { "enabled": true },
  // Next.js inlines a few functions as strings (e.g. the theme bootstrap script);
  // esbuild's name-keeping helper would leak into them as `__name is not defined`.
  "keep_names": false
  // Public config (NEXT_PUBLIC_*) is inlined at build time: set it as build
  // variables in the Cloudflare dashboard (Workers Builds → Settings) or in
  // .env.local when building locally.
}
